# ============================================================================
# Clothing Shop - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values
# ============================================================================

# ============================================================================
# Backend Configuration
# ============================================================================

# Server port (default: 3000)
PORT=3000

# Environment (development, production)
NODE_ENV=development

# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://[user[:password]@][netloc][:port][/dbname]
# Examples:
#   postgresql://postgres:password@localhost:5432/clothing_shop
#   postgresql://user:pass@db.example.com:5432/clothing_shop
DATABASE_URL=postgresql://postgres:password@localhost:5432/clothing_shop

# ============================================================================
# Stripe Configuration
# ============================================================================

# Stripe API Secret Key (for backend)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret (for webhook verification)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# ============================================================================
# Frontend Configuration
# ============================================================================

# API base URL (used by frontend)
# Development: http://localhost:3000/api
# Production: https://api.example.com/api
VITE_API_URL=http://localhost:3000/api

# Stripe Public Key (for frontend)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_your_public_key_here

# ============================================================================
# Email Configuration (Optional)
# ============================================================================

# Email service provider (sendgrid, mailgun, smtp)
EMAIL_PROVIDER=smtp

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email from address
EMAIL_FROM=noreply@example.com

# ============================================================================
# AWS Configuration (Optional - for image storage)
# ============================================================================

# AWS S3 bucket for product images
AWS_S3_BUCKET=clothing-shop-images
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ============================================================================
# JWT Configuration
# ============================================================================

# JWT secret key (for signing tokens)
# Generate: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# JWT expiration time (e.g., 7d, 24h, 30m)
JWT_EXPIRATION=7d

# ============================================================================
# CORS Configuration
# ============================================================================

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Analytics (Optional)
# ============================================================================

# Google Analytics ID
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Sentry DSN (for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# Feature Flags (Optional)
# ============================================================================

# Enable/disable features
ENABLE_GUEST_CHECKOUT=true
ENABLE_WISHLIST=false
ENABLE_REVIEWS=true
ENABLE_RECOMMENDATIONS=false

# ============================================================================
# Notes
# ============================================================================
# 
# 1. Never commit .env.local to version control
# 2. Keep sensitive values secure
# 3. Use different values for development and production
# 4. For production, use a secrets management service
# 5. Rotate secrets regularly
#
# ============================================================================
