{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/api-zod": ["./src/api-zod/index.ts"],
      "@workspace/api-spec": ["./src/api-spec/index.ts"],
      "@workspace/db": ["./src/db/index.ts"]
    }
  }
}
